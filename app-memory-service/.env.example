# Bearer token required on the MCP endpoint (/mcp).
# Leave empty to disable MCP auth — only sane on an isolated, single-user LAN.
#
# NOTE: the REST API (/api/*) is intentionally unauthenticated. On an untrusted
# network, put the whole service behind your reverse proxy / auth layer.
MEMORY_TOKEN=change-me-to-a-secure-token
